            }
          }
        },
        {
          "match": "\\$[A-Za-z_][\\w.\\[\\]]*\\$",
          "name": "keyword.control.substitution.sqlmap"
        },
        {
          "match": "#\\{(?:(?!\\]\\]>)[^}<])*\\}",
          "name": "variable.parameter.bind.sqlmap"
        },
        {
          "match": "\\$\\{(?:(?!\\]\\]>)[^}<])*\\}",
