    "placeholders": {
      "comment": "자리표시자. #x# 는 iBatis 인라인 파라미터 형태만 인정(#a#, #a.b#, #a[]#, #a:TYPE#, #a:TYPE:null값#, #a,jdbcType=X#): '#FF0000','#00FF00' 이나 ITEM#CD,STORE#CD, V$SESSION,V$LOCK 을 자리표시자로 보지 않기 위함. #{..}·${..} 는 MyBatis. $ 쪽은 문자열 치환이라 색을 달리함. 어느 것도 ]]> 와 < 를 넘지 못함",
      "patterns": [
        {
          "match": "(#)[A-Za-z_][\\w.\\[\\]]*(?::\\w+(?::[^#\\s<>'\"`()]*)?|(?:,\\w+=[\\w.]+)+)?(#)",
          "name": "variable.parameter.bind.sqlmap",
          "captures": {
